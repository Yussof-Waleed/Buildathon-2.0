option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: buildathon2.wsgi:application
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: |
      if [ -d /var/app/venv ]; then
        source /var/app/venv/*/bin/activate && python manage.py migrate --noinput
      fi
    leader_only: true
  02_collectstatic:
    command: |
      if [ -d /var/app/venv ]; then
        source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput
      fi
