# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok-free.app,.ngrok.io,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Paymob (test mode) — Settings → API Keys → View (TEST toggle ON)
# API key (optional — transaction inquiry): long base64 JWT-style string
PAYMOB_API_KEY=
# Secret key (Test) — NOT the API key; starts with egy_sk_test_
PAYMOB_SECRET_KEY=
# Public key (Test) — starts with egy_pk_test_
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Settings → Payment Integrations → Cards (Online) → TEST Integration ID
PAYMOB_INTEGRATION_ID_CARD=
# Public URL for webhook (use Cloudflare tunnel in dev)
PAYMOB_NOTIFICATION_URL=
PAYMOB_REDIRECTION_URL=

# Groq — Labeler / Tagger / Whisper STT (required for smart chat routing; omit for dumb intake fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Meta / WhatsApp Cloud API (developers.facebook.com → WhatsApp → API Setup)
# Use a permanent System User token — the dashboard "Generate access token" expires in ~24h.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string-you-remember
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
